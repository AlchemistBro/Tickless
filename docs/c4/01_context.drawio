<mxfile host="app.diagrams.net"><diagram name="Контекст" id="0"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#222222;" value="&lt;font style=&quot;font-size: 34px&quot;&gt;&lt;b&gt;Tickless: контекст системы&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 18px&quot; color=&quot;#666666&quot;&gt;C4, уровень 1 · спотовая биржа криптоактивов · сети только regtest и devnet&lt;/font&gt;" vertex="1"><mxGeometry x="30" y="14" width="2240" height="80" as="geometry"/></mxCell><mxCell id="c2" parent="1" style="shape=mxgraph.c4.person2;align=center;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#06315C;fontSize=17;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" value="&lt;font style=&quot;font-size: 22px&quot;&gt;&lt;b&gt;Трейдер&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;Регистрируется, пополняет счёт,&lt;br&gt;торгует, выводит средства&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="30" y="130" width="340" height="250" as="geometry"/></mxCell><mxCell id="c3" parent="1" style="shape=mxgraph.c4.person2;align=center;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#06315C;fontSize=17;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" value="&lt;font style=&quot;font-size: 22px&quot;&gt;&lt;b&gt;Бот / API-клиент&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;Внешняя программа&lt;br&gt;с HMAC-ключом API&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="30" y="470" width="340" height="250" as="geometry"/></mxCell><mxCell id="c4" parent="1" style="shape=mxgraph.c4.person2;align=center;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#06315C;fontSize=17;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" value="&lt;font style=&quot;font-size: 22px&quot;&gt;&lt;b&gt;Администратор&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;Замораживает пользователей,&lt;br&gt;одобряет крупные выводы&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="30" y="810" width="340" height="250" as="geometry"/></mxCell><mxCell id="c5" parent="1" style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;fontSize=18;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" value="&lt;font style=&quot;font-size: 36px&quot;&gt;&lt;b&gt;Tickless&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 21px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;Спотовая биржа: лимитные и рыночные ордера,&lt;br&gt;двойная бухгалтерия, рыночные данные и свечи,&lt;br&gt;депозиты и выводы BTC, ETH и USDT&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="850" y="330" width="560" height="400" as="geometry"/></mxCell><mxCell id="c6" parent="1" style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fillColor=#8B8496;fontColor=#FFFFFF;strokeColor=#6E6879;fontSize=18;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" value="&lt;font style=&quot;font-size: 24px&quot;&gt;&lt;b&gt;Bitcoin Core&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System: regtest]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;Блоки, транзакции, баланс&lt;br&gt;для депозитов и выводов BTC&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="1880" y="130" width="380" height="190" as="geometry"/></mxCell><mxCell id="c7" parent="1" style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fillColor=#8B8496;fontColor=#FFFFFF;strokeColor=#6E6879;fontSize=18;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" value="&lt;font style=&quot;font-size: 24px&quot;&gt;&lt;b&gt;Anvil&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System: Ethereum devnet]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;ETH и тестовый ERC-20 USDT&lt;br&gt;для депозитов и выводов&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="1880" y="380" width="380" height="190" as="geometry"/></mxCell><mxCell id="c8" parent="1" style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fillColor=#8B8496;fontColor=#FFFFFF;strokeColor=#6E6879;fontSize=18;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" value="&lt;font style=&quot;font-size: 24px&quot;&gt;&lt;b&gt;Mailpit&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System: SMTP]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;Принимает письма: подтверждение,&lt;br&gt;депозит, вывод, исполнение ордера&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="1880" y="630" width="380" height="190" as="geometry"/></mxCell><mxCell id="c9" parent="1" style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fillColor=#8B8496;fontColor=#FFFFFF;strokeColor=#6E6879;fontSize=18;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" value="&lt;font style=&quot;font-size: 24px&quot;&gt;&lt;b&gt;Наблюдаемость&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;Prometheus, Grafana,&lt;br&gt;Jaeger, Alertmanager&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="1880" y="880" width="380" height="190" as="geometry"/></mxCell><mxCell id="c10" edge="1" parent="1" source="c2" target="c5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#707070;strokeWidth=2;fontColor=#404040;fontSize=16;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" value="&lt;b&gt;Веб-терминал&lt;br&gt;HTTPS, WebSocket&lt;/b&gt;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" edge="1" parent="1" source="c3" target="c5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#707070;strokeWidth=2;fontColor=#404040;fontSize=16;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="&lt;b&gt;REST, WebSocket&lt;br&gt;HMAC&lt;/b&gt;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" edge="1" parent="1" source="c4" target="c5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#707070;strokeWidth=2;fontColor=#404040;fontSize=16;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" value="&lt;b&gt;Админ-запросы&lt;br&gt;HTTPS&lt;/b&gt;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" edge="1" parent="1" source="c5" target="c6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#707070;strokeWidth=2;fontColor=#404040;fontSize=16;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="&lt;b&gt;JSON-RPC&lt;/b&gt;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" edge="1" parent="1" source="c5" target="c7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#707070;strokeWidth=2;fontColor=#404040;fontSize=16;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="&lt;b&gt;JSON-RPC&lt;/b&gt;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" edge="1" parent="1" source="c5" target="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#707070;strokeWidth=2;fontColor=#404040;fontSize=16;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.65;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="&lt;b&gt;SMTP&lt;/b&gt;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" edge="1" parent="1" source="c5" target="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#707070;strokeWidth=2;fontColor=#404040;fontSize=16;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;dashPattern=8 4;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="&lt;b&gt;OTLP, метрики&lt;/b&gt;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="690"/><mxPoint x="1700" y="975"/></Array></mxGeometry></mxCell><mxCell id="c17" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#C9B458;fontColor=#333333;align=left;verticalAlign=top;spacing=10;fontSize=16;size=18;" value="Приватные ключи горячего кошелька есть только у сервиса signer внутри системы. Стрелка показывает направление запроса." vertex="1"><mxGeometry x="850" y="800" width="560" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>