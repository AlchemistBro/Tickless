        <mxCell id="title" value="&lt;b&gt;Сервисная архитектура Tickless — As Is (конец фазы 4)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="8" width="3110" height="26" as="geometry" /></mxCell>
        <mxCell id="sub" value="Контейнеры, сетевые сегменты и связи; Kafka — общий журнал событий, все потребители идемпотентны (at-least-once)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="24" y="34" width="3110" height="20" as="geometry" /></mxCell>
        <mxCell id="z_ext" value="&lt;b&gt;Внешняя сеть&lt;/b&gt;&lt;div&gt;[Интернет · браузер клиента]&lt;/div&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#8A8A8A;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;allowArrows=0;connectable=0;expand=0;recursiveResize=0;pointerEvents=0;absoluteArcSize=1;container=0;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="330" height="1060" as="geometry" /></mxCell>
        <mxCell id="z_acc" value="&lt;b&gt;Сегмент доступа&lt;/b&gt;&lt;div&gt;[Опубликованные порты 8088, 8080, 8081]&lt;/div&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#8A8A8A;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;allowArrows=0;connectable=0;expand=0;recursiveResize=0;pointerEvents=0;absoluteArcSize=1;container=0;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="320" height="1060" as="geometry" /></mxCell>
        <mxCell id="z_core" value="&lt;b&gt;Основная сеть&lt;/b&gt;&lt;div&gt;[Прикладные сервисы · Docker bridge «tickless»]&lt;/div&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#8A8A8A;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;allowArrows=0;connectable=0;expand=0;recursiveResize=0;pointerEvents=0;absoluteArcSize=1;container=0;" vertex="1" parent="1"><mxGeometry x="1340" y="70" width="1360" height="1060" as="geometry" /></mxCell>
        <mxCell id="z_data" value="&lt;b&gt;Сегмент данных&lt;/b&gt;&lt;div&gt;[Доступ из основной сети; порты опубликованы только для разработки]&lt;/div&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#8A8A8A;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;allowArrows=0;connectable=0;expand=0;recursiveResize=0;pointerEvents=0;absoluteArcSize=1;container=0;" vertex="1" parent="1"><mxGeometry x="1340" y="1180" width="1360" height="340" as="geometry" /></mxCell>
        <mxCell id="z_obs" value="&lt;b&gt;Зона контроля&lt;/b&gt;&lt;div&gt;[Только приём телеметрии]&lt;/div&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#8A8A8A;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;allowArrows=0;connectable=0;expand=0;recursiveResize=0;pointerEvents=0;absoluteArcSize=1;container=0;" vertex="1" parent="1"><mxGeometry x="2770" y="520" width="370" height="1000" as="geometry" /></mxCell>
        <mxCell id="trader" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;Трейдер&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Регистрируется, пополняет счёт, торгует, смотрит рынок&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="shape=mxgraph.c4.person2;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#06315C;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="20" y="150" width="220" height="190" as="geometry" /></mxCell>
        <mxCell id="bot" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;Бот / API-клиент&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Те же операции; подпись запросов API-ключом HMAC&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="shape=mxgraph.c4.person2;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#06315C;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="20" y="655" width="220" height="190" as="geometry" /></mxCell>
        <mxCell id="spa" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;Веб-терминал&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: React 18, TypeScript, Vite]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Виджеты: график, стакан, сделки, ввод заявки, балансы; раскладка в localStorage&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="shape=mxgraph.c4.webBrowserContainer2;boundedLbl=1;strokeColor2=#0E7DAD;align=center;verticalAlign=middle;spacingTop=14;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="380" y="150" width="240" height="190" as="geometry" /></mxCell>
        <mxCell id="nginx" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;web (nginx)&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: nginx :8088]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Отдаёт SPA, проксирует /v1 и /ws в шлюз&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="830" y="150" width="260" height="190" as="geometry" /></mxCell>
        <mxCell id="gw" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;gateway&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go, chi, coder/websocket :8080]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Единственная точка входа: REST (OpenAPI), JWT Ed25519 и HMAC, лимиты, идемпотентность, проверка заморозки, публичный и приватный WS&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="830" y="640" width="260" height="230" as="geometry" /></mxCell>
        <mxCell id="idn" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;identity&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go, gRPC :9103]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Пользователи, argon2id, сессии, refresh-токены, API-ключи, роли, заморозка&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="1380" y="120" width="300" height="180" as="geometry" /></mxCell>
        <mxCell id="ord" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;orders&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go, gRPC :9102]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Сага выставления: валидация, холд, заявка + outbox в одной транзакции; применение исполнений; sweeper&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="1380" y="500" width="300" height="180" as="geometry" /></mxCell>
        <mxCell id="led" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;ledger&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go, gRPC :9101]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Двойная запись: холды, расчёт сделок и комиссий, балансы = сумма проводок (ограничения БД)&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="1380" y="880" width="300" height="180" as="geometry" /></mxCell>
        <mxCell id="mat" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;matching&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go, без БД]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;По горутине на партицию; детерминированный автомат; seq без пропусков; чекпоинты в томе matchingdata&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="2280" y="120" width="300" height="180" as="geometry" /></mxCell>
        <mxCell id="cnd" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;candles&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go, gRPC :9106]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Идемпотентная вставка сделок в ClickHouse, 6 материализованных представлений 1m…1d, candles.live&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="2280" y="500" width="300" height="180" as="geometry" /></mxCell>
        <mxCell id="md" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;marketdata&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go, HTTP/WebSocket :8081]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Стакан, сделки, тикер 24h из matching.events; снимки в Redis; REST /v1/market/*, публичный WS&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="2280" y="880" width="300" height="180" as="geometry" /></mxCell>
        <mxCell id="kafka" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;Kafka&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Queue: KRaft, 1 узел]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;matching.commands и matching.events: партиции по рынку, бессрочное хранение; ledger.events, users.events, candles.live&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="shape=cylinder3;size=15;boundedLbl=1;backgroundOutline=1;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;horizontal=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="1880" y="120" width="200" height="940" as="geometry" /></mxCell>
        <mxCell id="pgb" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;PgBouncer&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: transaction pooling :6432]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Весь трафик сервисов к БД (миграции напрямую)&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="1380" y="1225" width="250" height="150" as="geometry" /></mxCell>
        <mxCell id="pg" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Database: одна БД на сервис]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;БД identity, orders, ledger + outbox, processed_events&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="shape=cylinder3;size=15;boundedLbl=1;backgroundOutline=1;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="1680" y="1210" width="260" height="180" as="geometry" /></mxCell>
        <mxCell id="ch" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;ClickHouse&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Database: БД tickless]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Сделки и агрегаты свечей&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="shape=cylinder3;size=15;boundedLbl=1;backgroundOutline=1;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="1990" y="1210" width="240" height="180" as="geometry" /></mxCell>
        <mxCell id="redis" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;Redis 7&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Database: go-redis]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Лимиты, ключи идемпотентности, замороженные, снимки md:snap:*&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="shape=cylinder3;size=15;boundedLbl=1;backgroundOutline=1;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="2310" y="1210" width="240" height="180" as="geometry" /></mxCell>
        <mxCell id="rabbit" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: RabbitMQ]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Запущен, не используется: резерв под фазу 6&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#8B8496;fontColor=#FFFFFF;strokeColor=#6E6879;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="2810" y="120" width="290" height="140" as="geometry" /></mxCell>
        <mxCell id="mail" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;Mailpit&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: SMTP catcher]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Запущен, не используется: в dev email подтверждается автоматически&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#8B8496;fontColor=#FFFFFF;strokeColor=#6E6879;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="2810" y="320" width="290" height="140" as="geometry" /></mxCell>
