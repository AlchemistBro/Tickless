        <mxCell id="a7" value='&lt;div style="text-align: center"&gt;&lt;b&gt;gRPC и HTTP к сервисам&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align: center"&gt;Ответ: ответы&lt;/div&gt;&lt;div style="text-align: center"&gt;[ClusterIP Services]&lt;/div&gt;' style="rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#707070;strokeWidth=2;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=10;edgeStyle=orthogonalEdgeStyle;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.42;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="gw" target="ns_app"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
