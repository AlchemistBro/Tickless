tyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#707070;strokeWidth=2;fontColor=#404040;fontSize=16;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" value="&lt;b&gt;SQL, Kafka, AMQP&lt;/b&gt;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" edge="1" parent="1" source="c12" target="c24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#707070;strokeWidth=2;fontColor=#404040;fontSize=16;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="&lt;b&gt;JSON-RPC&lt;/b&gt;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" edge="1" parent="1" source="c12" target="c25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#707070;strokeWidth=2;fontColor=#404040;fontSize=16;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="&lt;b&gt;JSON-RPC&lt;/b&gt;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" edge="1" parent="1" source="c12" target="c26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#707070;strokeWidth=2;fontColor=#404040;fontSize=16;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="&lt;b&gt;SMTP&lt;/b&gt;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#C9B458;fontColor=#333333;align=left;verticalAlign=top;spacing=10;fontSize=16;size=18;" value="&lt;b&gt;Ключевые потоки&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Ордер.&lt;/b&gt; gateway → orders → ledger (холд) → Kafka → matching → события → orders, ledger, marketdata, candles.&lt;br&gt;&lt;br&gt;&lt;b&gt;Депозит.&lt;/b&gt; wallet выдаёт адрес → chainwatcher ждёт подтверждения → ledger зачисляет один раз → notifier шлёт письмо.&lt;br&gt;&lt;br&gt;&lt;b&gt;Вывод.&lt;/b&gt; withdrawals (TOTP, лимит) → холд → проверка → автоисполнение или ревью администратора → signer (mTLS) → сеть.&lt;br&gt;&lt;br&gt;События публикуются через outbox в той же транзакции, что и изменение данных." vertex="1"><mxGeometry x="30" y="800" width="640" height="420" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>