        <mxCell id="title" value="&lt;b&gt;Сервисная архитектура Tickless — To Be (после фаз 5–11)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="8" width="3590" height="26" as="geometry" /></mxCell>
        <mxCell id="sub" value="Добавлены ввод и вывод криптовалют, подпись, уведомления, сверка и бэк-офис; оранжевая рамка — новый элемент, оранжевый пунктир — изменённый" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="24" y="34" width="3590" height="20" as="geometry" /></mxCell>
        <mxCell id="z_ext" value="&lt;b&gt;Внешняя сеть&lt;/b&gt;&lt;div&gt;[Интернет · браузер клиента]&lt;/div&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#8A8A8A;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;allowArrows=0;connectable=0;expand=0;recursiveResize=0;pointerEvents=0;absoluteArcSize=1;container=0;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="330" height="1250" as="geometry" /></mxCell>
        <mxCell id="z_acc" value="&lt;b&gt;Сегмент доступа&lt;/b&gt;&lt;div&gt;[Опубликованные порты / вход в кластер]&lt;/div&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#8A8A8A;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;allowArrows=0;connectable=0;expand=0;recursiveResize=0;pointerEvents=0;absoluteArcSize=1;container=0;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="320" height="1250" as="geometry" /></mxCell>
        <mxCell id="z_core" value="&lt;b&gt;Основная сеть&lt;/b&gt;&lt;div&gt;[Прикладные сервисы]&lt;/div&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#8A8A8A;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;allowArrows=0;connectable=0;expand=0;recursiveResize=0;pointerEvents=0;absoluteArcSize=1;container=0;" vertex="1" parent="1"><mxGeometry x="1340" y="70" width="1820" height="1500" as="geometry" /></mxCell>
        <mxCell id="z_data" value="&lt;b&gt;Сегмент данных&lt;/b&gt;&lt;div&gt;[Доступ только из основной сети]&lt;/div&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#8A8A8A;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;allowArrows=0;connectable=0;expand=0;recursiveResize=0;pointerEvents=0;absoluteArcSize=1;container=0;" vertex="1" parent="1"><mxGeometry x="1340" y="1620" width="1820" height="360" as="geometry" /></mxCell>
        <mxCell id="z_chain" value="&lt;b&gt;Блокчейн-ноды&lt;/b&gt;&lt;div&gt;[Тестовые сети: regtest, devnet]&lt;/div&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#8A8A8A;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;allowArrows=0;connectable=0;expand=0;recursiveResize=0;pointerEvents=0;absoluteArcSize=1;container=0;" vertex="1" parent="1"><mxGeometry x="3230" y="700" width="370" height="500" as="geometry" /></mxCell>
        <mxCell id="z_sign" value="&lt;b&gt;Изолированный сегмент подписи&lt;/b&gt;&lt;div&gt;[mTLS · доступ только у withdrawals]&lt;/div&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#8A8A8A;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;allowArrows=0;connectable=0;expand=0;recursiveResize=0;pointerEvents=0;absoluteArcSize=1;container=0;" vertex="1" parent="1"><mxGeometry x="3230" y="1260" width="370" height="310" as="geometry" /></mxCell>
        <mxCell id="z_obs" value="&lt;b&gt;Зона контроля&lt;/b&gt;&lt;div&gt;[Только приём телеметрии]&lt;/div&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#8A8A8A;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;allowArrows=0;connectable=0;expand=0;recursiveResize=0;pointerEvents=0;absoluteArcSize=1;container=0;" vertex="1" parent="1"><mxGeometry x="3230" y="1620" width="370" height="760" as="geometry" /></mxCell>
        <mxCell id="trader" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;Трейдер&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Торгует, пополняет счёт, выводит средства с TOTP&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="shape=mxgraph.c4.person2;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#06315C;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="20" y="150" width="220" height="190" as="geometry" /></mxCell>
        <mxCell id="bot" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;Бот / API-клиент&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Те же операции; подпись запросов API-ключом HMAC&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="shape=mxgraph.c4.person2;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#06315C;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="20" y="650" width="220" height="190" as="geometry" /></mxCell>
        <mxCell id="adm" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;Администратор&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Замораживает пользователей, останавливает рынки, одобряет выводы, читает отчёты сверки&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="shape=mxgraph.c4.person2;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#06315C;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="20" y="960" width="220" height="190" as="geometry" /></mxCell>
        <mxCell id="spa" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;Веб-терминал&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: React 18, TypeScript]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;+ вход и подтверждение email, адрес депозита, выводы, история, страницы администратора&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="shape=mxgraph.c4.webBrowserContainer2;boundedLbl=1;strokeColor2=#0E7DAD;align=center;verticalAlign=middle;spacingTop=14;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;strokeColor=#E8A33D;strokeWidth=4;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="380" y="150" width="240" height="200" as="geometry" /></mxCell>
        <mxCell id="nginx" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;web (nginx)&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: nginx]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Отдаёт SPA, проксирует /v1 и /ws в шлюз&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="830" y="150" width="260" height="190" as="geometry" /></mxCell>
        <mxCell id="gw" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;gateway&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go, chi, coder/websocket]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;+ маршруты депозитов, выводов и администрирования; проксирует admin gRPC; проверка email и заморозки для выводов&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];strokeColor=#E8A33D;strokeWidth=4;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="830" y="620" width="260" height="250" as="geometry" /></mxCell>
        <mxCell id="idn" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;identity&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go, gRPC, PostgreSQL]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;+ TOTP-секреты (шифрованы), реальное подтверждение email через notifier; без IDENTITY_AUTO_VERIFY&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];strokeColor=#E8A33D;strokeWidth=4;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="1380" y="120" width="300" height="180" as="geometry" /></mxCell>
        <mxCell id="ord" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;orders&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go, gRPC, PostgreSQL]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Сага выставления, outbox, исполнения; + месячное партиционирование заявок&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="1380" y="500" width="300" height="180" as="geometry" /></mxCell>
        <mxCell id="led" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;ledger&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go, gRPC, PostgreSQL]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;+ зачисление депозитов и списание выводов, счета горячего кошелька и комиссий; партиционирование проводок&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];strokeColor=#E8A33D;strokeWidth=4;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="1380" y="880" width="300" height="180" as="geometry" /></mxCell>
        <mxCell id="admin" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;admin&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go, gRPC за шлюзом]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Back-office API: пользователи, остановка рынков, очередь проверки выводов, отчёты сверки, журнал любого счёта&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];strokeColor=#E8A33D;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="1380" y="1300" width="300" height="180" as="geometry" /></mxCell>
        <mxCell id="mat" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;matching&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go, StatefulSet]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;По горутине на партицию; детерминированный автомат; чекпоинты на PVC&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="2280" y="120" width="300" height="180" as="geometry" /></mxCell>
        <mxCell id="cnd" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;candles&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go, gRPC, ClickHouse]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Сделки в ClickHouse, свечи 1m…1d, candles.live&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="2280" y="500" width="300" height="180" as="geometry" /></mxCell>
        <mxCell id="md" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;marketdata&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go, HTTP/WebSocket]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Стакан, сделки, тикер; снимки в Redis; публичный WS&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];" vertex="1" parent="1"><mxGeometry x="2280" y="880" width="300" height="180" as="geometry" /></mxCell>
        <mxCell id="wallet" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;wallet&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go, gRPC, PostgreSQL]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Адрес депозита на пользователя и сеть из xpub (BIP32/44); приватных ключей не хранит&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];strokeColor=#E8A33D;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="2280" y="1300" width="300" height="180" as="geometry" /></mxCell>
        <mxCell id="rec" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;reconciler&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go, по расписанию]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Инварианты ledger, ledger против блокчейна, ledger против сделок; отчёты и алерты&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];strokeColor=#E8A33D;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="2780" y="120" width="300" height="180" as="geometry" /></mxCell>
        <mxCell id="ntf" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;notifier&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go, RabbitMQ, SMTP]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 10px"&gt;&lt;font color="#d9ecf8"&gt;Шаблоны писем (email, депозиты, выводы, исполнения), повторы с backoff, DLQ&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fontSize=11;metaEdit=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0],[0.25,0,0],[0.75,0,0]];strokeColor=#E8A33D;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="2780" y="500" width="300" height="180" as="geometry" /></mxCell>
