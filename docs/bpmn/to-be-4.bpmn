<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs" targetNamespace="http://tickless.example/bpmn" exporter="bpmnrows" exporterVersion="2">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Pool_Adj" name="Смежный процесс: размещение ассортимента на платформе" />
    <bpmn:participant id="Pool_Main_r1" name="TO BE · ряд 1/3" processRef="Proc_P4_r1" />
    <bpmn:participant id="Pool_Main_r2" name="TO BE · ряд 2/3" processRef="Proc_P4_r2" />
    <bpmn:participant id="Pool_Main_r3" name="TO BE · ряд 3/3" processRef="Proc_P4_r3" />
    <bpmn:messageFlow id="mf5" sourceRef="E4" targetRef="Pool_Adj" name="Позиции, готовые к публикации" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P4_r1" name="ООО «ОСКЕЛИ ГРУПП»: подготовка и проверка товарных данных (TO BE) · ряд 1" isExecutable="false">
    <bpmn:laneSet id="Proc_P4_r1_laneset">
      <bpmn:lane id="Lane_Spec_r1" name="Специалист по ассортименту и контенту">
        <bpmn:flowNodeRef>LEc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKT0_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="LEc" name="Позиции загружены в системы (E)">
      <bpmn:outgoing>k1</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LEc_def" name="E" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="S9" name="Выборочно проверить созданные карточки">
      <bpmn:incoming>k1</bpmn:incoming>
      <bpmn:outgoing>SFT0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="LKT0_1" name="Переход к ряду 2">
      <bpmn:incoming>SFT0_1</bpmn:incoming>
      <bpmn:linkEventDefinition id="LKT0_1_def" name="R1" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="k1" sourceRef="LEc" targetRef="S9" />
    <bpmn:sequenceFlow id="SFT0_1" sourceRef="S9" targetRef="LKT0_1" />
  </bpmn:process>
  <bpmn:process id="Proc_P4_r2" name="ООО «ОСКЕЛИ ГРУПП»: подготовка и проверка товарных данных (TO BE) · ряд 2" isExecutable="false">
    <bpmn:laneSet id="Proc_P4_r2_laneset">
      <bpmn:lane id="Lane_Spec_r2" name="Специалист по ассортименту и контенту">
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKC0_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKT0_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKT0_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="G4" name="Замечания к карточкам есть?">
      <bpmn:incoming>SFK0_1</bpmn:incoming>
      <bpmn:outgoing>SFT0_2</bpmn:outgoing>
      <bpmn:outgoing>k4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="S10" name="Внести исправления в карточки товаров">
      <bpmn:incoming>k4</bpmn:incoming>
      <bpmn:outgoing>SFT0_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="LKC0_1" name="Переход из ряда 1">
      <bpmn:outgoing>SFK0_1</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LKC0_1_def" name="R1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="LKT0_2" name="Переход к ряду 3">
      <bpmn:incoming>SFT0_2</bpmn:incoming>
      <bpmn:linkEventDefinition id="LKT0_2_def" name="R2" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="LKT0_3" name="Переход к ряду 3">
      <bpmn:incoming>SFT0_3</bpmn:incoming>
      <bpmn:linkEventDefinition id="LKT0_3_def" name="R3" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="SFK0_1" sourceRef="LKC0_1" targetRef="G4" />
    <bpmn:sequenceFlow id="SFT0_2" sourceRef="G4" targetRef="LKT0_2" />
    <bpmn:sequenceFlow id="k4" sourceRef="G4" targetRef="S10" name="да" />
    <bpmn:sequenceFlow id="SFT0_3" sourceRef="S10" targetRef="LKT0_3" />
  </bpmn:process>
  <bpmn:process id="Proc_P4_r3" name="ООО «ОСКЕЛИ ГРУПП»: подготовка и проверка товарных данных (TO BE) · ряд 3" isExecutable="false">
    <bpmn:laneSet id="Proc_P4_r3_laneset">
      <bpmn:lane id="Lane_Spec_r3" name="Специалист по ассортименту и контенту">
        <bpmn:flowNodeRef>S11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKC0_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKC0_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="S11" name="Подтвердить готовность позиций к публикации">
      <bpmn:incoming>SFK0_2</bpmn:incoming>
      <bpmn:incoming>SFK0_3</bpmn:incoming>
      <bpmn:outgoing>k6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E4" name="Данные переданы на размещение">
      <bpmn:incoming>k6</bpmn:incoming>
      <bpmn:messageEventDefinition id="E4_def" />
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="LKC0_2" name="Переход из ряда 2">
      <bpmn:outgoing>SFK0_2</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LKC0_2_def" name="R2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="LKC0_3" name="Переход из ряда 2">
      <bpmn:outgoing>SFK0_3</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LKC0_3_def" name="R3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="SFK0_2" sourceRef="LKC0_2" targetRef="S11" name="нет" />
    <bpmn:sequenceFlow id="SFK0_3" sourceRef="LKC0_3" targetRef="S11" />
    <bpmn:sequenceFlow id="k6" sourceRef="S11" targetRef="E4" />
  </bpmn:process>
