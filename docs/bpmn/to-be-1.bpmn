<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs" targetNamespace="http://tickless.example/bpmn" exporter="bpmnrows" exporterVersion="2">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Pool_Partner" name="Профессиональный партнёр (бутик)" />
    <bpmn:participant id="Pool_Main_r1" name="ООО «ОСКЕЛИ ГРУПП»: подготовка и проверка товарн… · ряд 1/4" processRef="Proc_P1_r1" />
    <bpmn:participant id="Pool_Main_r2" name="ООО «ОСКЕЛИ ГРУПП»: подготовка и проверка товарн… · ряд 2/4" processRef="Proc_P1_r2" />
    <bpmn:participant id="Pool_Main_r3" name="ООО «ОСКЕЛИ ГРУПП»: подготовка и проверка товарн… · ряд 3/4" processRef="Proc_P1_r3" />
    <bpmn:participant id="Pool_Main_r4" name="ООО «ОСКЕЛИ ГРУПП»: подготовка и проверка товарн… · ряд 4/4" processRef="Proc_P1_r4" />
    <bpmn:messageFlow id="mf1" sourceRef="Pool_Partner" targetRef="St1" name="Реестр ассортимента" />
    <bpmn:messageFlow id="mf2" sourceRef="T2" targetRef="Pool_Partner" name="Замечания к реестру" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P1_r1" name="ООО «ОСКЕЛИ ГРУПП»: подготовка и проверка товарных данных (TO BE) · ряд 1" isExecutable="false">
    <bpmn:laneSet id="Proc_P1_r1_laneset">
      <bpmn:lane id="Lane_B2B_r1" name="Менеджер B2B-направления">
        <bpmn:flowNodeRef>St1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKT0_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Robot_r1" name="Цифровой ассистент">
        <bpmn:flowNodeRef>LCc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rerr1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LDt1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKT0_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKC0_6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="St1" name="Реестр ассортимента получен от партнёра">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="St1_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Проверить состав и комплектность реестра">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>SFT0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="LCc" name="Повторная обработка (C)">
      <bpmn:outgoing>SFT0_4</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LCc_def" name="C" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Rerr1" name="Уведомить специалиста о сбое обработки">
      <bpmn:incoming>SFK0_6</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateThrowEvent id="LDt1" name="К устранению сбоя (D)">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:linkEventDefinition id="LDt1_def" name="D" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="LKT0_1" name="Переход к ряду 2">
      <bpmn:incoming>SFT0_1</bpmn:incoming>
      <bpmn:linkEventDefinition id="LKT0_1_def" name="R1" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="LKT0_4" name="Переход к ряду 3">
      <bpmn:incoming>SFT0_4</bpmn:incoming>
      <bpmn:linkEventDefinition id="LKT0_4_def" name="R4" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="LKC0_6" name="Переход из ряда 4">
      <bpmn:outgoing>SFK0_6</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LKC0_6_def" name="R6" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="St1" targetRef="T1" />
    <bpmn:sequenceFlow id="SFT0_1" sourceRef="T1" targetRef="LKT0_1" />
    <bpmn:sequenceFlow id="SFT0_4" sourceRef="LCc" targetRef="LKT0_4" />
    <bpmn:sequenceFlow id="SFK0_6" sourceRef="LKC0_6" targetRef="Rerr1" />
    <bpmn:sequenceFlow id="f12" sourceRef="Rerr1" targetRef="LDt1" />
  </bpmn:process>
  <bpmn:process id="Proc_P1_r2" name="ООО «ОСКЕЛИ ГРУПП»: подготовка и проверка товарных данных (TO BE) · ряд 2" isExecutable="false">
    <bpmn:laneSet id="Proc_P1_r2_laneset">
      <bpmn:lane id="Lane_B2B_r2" name="Менеджер B2B-направления">
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKC0_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKT0_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKT0_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Robot_r2" name="Цифровой ассистент">
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="G1" name="Реестр комплектен?">
      <bpmn:incoming>SFK0_1</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T2" name="Вернуть реестр партнёру с перечнем замечаний">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>SFT0_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="T3" name="Зарегистрировать поступление реестра">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>SFT0_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="LKC0_1" name="Переход из ряда 1">
      <bpmn:outgoing>SFK0_1</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LKC0_1_def" name="R1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="LKT0_2" name="Переход к ряду 3">
      <bpmn:incoming>SFT0_2</bpmn:incoming>
      <bpmn:linkEventDefinition id="LKT0_2_def" name="R2" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="LKT0_3" name="Переход к ряду 3">
      <bpmn:incoming>SFT0_3</bpmn:incoming>
      <bpmn:linkEventDefinition id="LKT0_3_def" name="R3" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="SFK0_1" sourceRef="LKC0_1" targetRef="G1" />
    <bpmn:sequenceFlow id="f3" sourceRef="G1" targetRef="T2" name="нет" />
    <bpmn:sequenceFlow id="SFT0_2" sourceRef="T2" targetRef="LKT0_2" />
    <bpmn:sequenceFlow id="f5" sourceRef="G1" targetRef="T3" name="да" />
    <bpmn:sequenceFlow id="SFT0_3" sourceRef="T3" targetRef="LKT0_3" />
  </bpmn:process>
  <bpmn:process id="Proc_P1_r3" name="ООО «ОСКЕЛИ ГРУПП»: подготовка и проверка товарных данных (TO BE) · ряд 3" isExecutable="false">
    <bpmn:laneSet id="Proc_P1_r3_laneset">
      <bpmn:lane id="Lane_B2B_r3" name="Менеджер B2B-направления">
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKC0_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKC0_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Robot_r3" name="Цифровой ассистент">
        <bpmn:flowNodeRef>G0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKC0_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKT0_5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:endEvent id="E1" name="Реестр возвращён на доработку">
      <bpmn:incoming>SFK0_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T3b" name="Передать файл реестра цифровому ассистенту">
      <bpmn:incoming>SFK0_3</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G0">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:incoming>SFK0_4</bpmn:incoming>
      <bpmn:outgoing>SFT0_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="LKC0_2" name="Переход из ряда 2">
      <bpmn:outgoing>SFK0_2</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LKC0_2_def" name="R2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="LKC0_3" name="Переход из ряда 2">
      <bpmn:outgoing>SFK0_3</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LKC0_3_def" name="R3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="LKC0_4" name="Переход из ряда 1">
      <bpmn:outgoing>SFK0_4</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LKC0_4_def" name="R4" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="LKT0_5" name="Переход к ряду 4">
      <bpmn:incoming>SFT0_5</bpmn:incoming>
      <bpmn:linkEventDefinition id="LKT0_5_def" name="R5" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="SFK0_2" sourceRef="LKC0_2" targetRef="E1" />
    <bpmn:sequenceFlow id="SFK0_3" sourceRef="LKC0_3" targetRef="T3b" />
    <bpmn:sequenceFlow id="f7" sourceRef="T3b" targetRef="G0" />
    <bpmn:sequenceFlow id="SFK0_4" sourceRef="LKC0_4" targetRef="G0" />
    <bpmn:sequenceFlow id="SFT0_5" sourceRef="G0" targetRef="LKT0_5" />
  </bpmn:process>
  <bpmn:process id="Proc_P1_r4" name="ООО «ОСКЕЛИ ГРУПП»: подготовка и проверка товарных данных (TO BE) · ряд 4" isExecutable="false">
    <bpmn:laneSet id="Proc_P1_r4_laneset">
      <bpmn:lane id="Lane_B2B_r4" name="Менеджер B2B-направления">
      </bpmn:lane>
      <bpmn:lane id="Lane_Robot_r4" name="Цифровой ассистент">
        <bpmn:flowNodeRef>R1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LAt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKC0_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKT0_6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="R1" name="Считать позиции реестра из файла">
      <bpmn:incoming>SFK0_5</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BE1" name="Ошибка чтения файла" attachedToRef="R1">
      <bpmn:outgoing>SFT0_6</bpmn:outgoing>
      <bpmn:errorEventDefinition id="BE1_def" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="LAt" name="К обработке данных (A)">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:linkEventDefinition id="LAt_def" name="A" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="LKC0_5" name="Переход из ряда 3">
      <bpmn:outgoing>SFK0_5</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LKC0_5_def" name="R5" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="LKT0_6" name="Переход к ряду 1">
      <bpmn:incoming>SFT0_6</bpmn:incoming>
      <bpmn:linkEventDefinition id="LKT0_6_def" name="R6" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="SFK0_5" sourceRef="LKC0_5" targetRef="R1" />
    <bpmn:sequenceFlow id="f10" sourceRef="R1" targetRef="LAt" />
    <bpmn:sequenceFlow id="SFT0_6" sourceRef="BE1" targetRef="LKT0_6" />
  </bpmn:process>
