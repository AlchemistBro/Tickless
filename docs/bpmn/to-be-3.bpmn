<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs" targetNamespace="http://tickless.example/bpmn" exporter="bpmnrows" exporterVersion="2">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Pool_Partner" name="Профессиональный партнёр (бутик)" />
    <bpmn:participant id="Pool_Main_r1" name="TO BE · ряд 1/5" processRef="Proc_P3_r1" />
    <bpmn:participant id="Pool_Main_r2" name="TO BE · ряд 2/5" processRef="Proc_P3_r2" />
    <bpmn:participant id="Pool_Main_r3" name="TO BE · ряд 3/5" processRef="Proc_P3_r3" />
    <bpmn:participant id="Pool_Main_r4" name="TO BE · ряд 4/5" processRef="Proc_P3_r4" />
    <bpmn:participant id="Pool_Main_r5" name="TO BE · ряд 5/5" processRef="Proc_P3_r5" />
    <bpmn:messageFlow id="mf3" sourceRef="S5" targetRef="Pool_Partner" name="Запрос уточнений" />
    <bpmn:messageFlow id="mf4" sourceRef="Pool_Partner" targetRef="M1" name="Уточнённые данные" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P3_r1" name="ООО «ОСКЕЛИ ГРУПП»: подготовка и проверка товарных данных (TO BE) · ряд 1" isExecutable="false">
    <bpmn:laneSet id="Proc_P3_r1_laneset">
      <bpmn:lane id="Lane_Spec_r1" name="Специалист по ассортименту и контенту">
        <bpmn:flowNodeRef>LBc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKT0_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="LBc" name="Отчёт об обработке получен (B)">
      <bpmn:outgoing>h1</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LBc_def" name="B" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="S4" name="Изучить отчёт и перечень несоответствий">
      <bpmn:incoming>h1</bpmn:incoming>
      <bpmn:outgoing>SFT0_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="LKT0_1" name="Переход к ряду 2">
      <bpmn:incoming>SFT0_1</bpmn:incoming>
      <bpmn:linkEventDefinition id="LKT0_1_def" name="R1" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="h1" sourceRef="LBc" targetRef="S4" />
    <bpmn:sequenceFlow id="SFT0_1" sourceRef="S4" targetRef="LKT0_1" />
  </bpmn:process>
  <bpmn:process id="Proc_P3_r2" name="ООО «ОСКЕЛИ ГРУПП»: подготовка и проверка товарных данных (TO BE) · ряд 2" isExecutable="false">
    <bpmn:laneSet id="Proc_P3_r2_laneset">
      <bpmn:lane id="Lane_Spec_r2" name="Специалист по ассортименту и контенту">
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LE1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKC0_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKT0_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="G2" name="Несоответствия выявлены?">
      <bpmn:incoming>SFK0_1</bpmn:incoming>
      <bpmn:outgoing>h3</bpmn:outgoing>
      <bpmn:outgoing>h4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="S5" name="Направить партнёру запрос на уточнение данных">
      <bpmn:incoming>h3</bpmn:incoming>
      <bpmn:outgoing>SFT0_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateThrowEvent id="LE1" name="К контролю результата (E)">
      <bpmn:incoming>h4</bpmn:incoming>
      <bpmn:linkEventDefinition id="LE1_def" name="E" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="LKC0_1" name="Переход из ряда 1">
      <bpmn:outgoing>SFK0_1</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LKC0_1_def" name="R1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="LKT0_2" name="Переход к ряду 3">
      <bpmn:incoming>SFT0_2</bpmn:incoming>
      <bpmn:linkEventDefinition id="LKT0_2_def" name="R2" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="SFK0_1" sourceRef="LKC0_1" targetRef="G2" />
    <bpmn:sequenceFlow id="h3" sourceRef="G2" targetRef="S5" name="да" />
    <bpmn:sequenceFlow id="h4" sourceRef="G2" targetRef="LE1" name="нет" />
    <bpmn:sequenceFlow id="SFT0_2" sourceRef="S5" targetRef="LKT0_2" />
  </bpmn:process>
  <bpmn:process id="Proc_P3_r3" name="ООО «ОСКЕЛИ ГРУПП»: подготовка и проверка товарных данных (TO BE) · ряд 3" isExecutable="false">
    <bpmn:laneSet id="Proc_P3_r3_laneset">
      <bpmn:lane id="Lane_Spec_r3" name="Специалист по ассортименту и контенту">
        <bpmn:flowNodeRef>EG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TM1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKC0_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKT0_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LKT0_4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:eventBasedGateway id="EG" name="Ожидание ответа партнёра">
      <bpmn:incoming>SFK0_2</bpmn:incoming>
      <bpmn:outgoing>h6</bpmn:outgoing>
      <bpmn:outgoing>h7</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="M1" name="Уточнения от партнёра получены">
      <bpmn:incoming>h6</bpmn:incoming>
      <bpmn:outgoing>SFT0_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="M1_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="TM1" name="Срок ответа истёк (5 рабочих дней)">
      <bpmn:incoming>h7</bpmn:incoming>
      <bpmn:outgoing>SFT0_4</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TM1_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="LKC0_2" name="Переход из ряда 2">
      <bpmn:outgoing>SFK0_2</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LKC0_2_def" name="R2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="LKT0_3" name="Переход к ряду 4">
      <bpmn:incoming>SFT0_3</bpmn:incoming>
      <bpmn:linkEventDefinition id="LKT0_3_def" name="R3" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="LKT0_4" name="Переход к ряду 4">
      <bpmn:incoming>SFT0_4</bpmn:incoming>
      <bpmn:linkEventDefinition id="LKT0_4_def" name="R4" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="SFK0_2" sourceRef="LKC0_2" targetRef="EG" />
    <bpmn:sequenceFlow id="h6" sourceRef="EG" targetRef="M1" />
    <bpmn:sequenceFlow id="h7" sourceRef="EG" targetRef="TM1" />
    <bpmn:sequenceFlow id="SFT0_3" sourceRef="M1" targetRef="LKT0_3" />
    <bpmn:sequenceFlow id="SFT0_4" sourceRef="TM1" targetRef="LKT0_4" />
  </bpmn:process>
  <bpmn:process id="Proc_P3_r4" name="ООО «ОСКЕЛИ ГРУПП»: подготовка и проверка товарных данных (TO BE) · ряд 4" isExecutable="false">
