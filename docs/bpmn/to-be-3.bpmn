    <bpmn:sequenceFlow id="SFK0_3" sourceRef="LKC0_3" targetRef="S6" />
    <bpmn:sequenceFlow id="h9" sourceRef="S6" targetRef="LCt2" />
    <bpmn:sequenceFlow id="SFK0_4" sourceRef="LKC0_4" targetRef="S7" />
