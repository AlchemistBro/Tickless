    <bpmn:userTask id="S6" name="Подготовить файл уточнённых позиций">
      <bpmn:incoming>SFK0_3</bpmn:incoming>
      <bpmn:outgoing>h9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="S7" name="Исключить неуточнённые позиции из обработки">
      <bpmn:incoming>SFK0_4</bpmn:incoming>
      <bpmn:outgoing>h11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="LCt2" name="Повторная обработка (C)">
      <bpmn:incoming>h9</bpmn:incoming>
      <bpmn:linkEventDefinition id="LCt2_def" name="C" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="G3" name="Остались позиции для публикации?">
      <bpmn:incoming>h11</bpmn:incoming>
      <bpmn:outgoing>SFT0_5</bpmn:outgoing>
      <bpmn:outgoing>SFT0_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="LKC0_3" name="Переход из ряда 3">
      <bpmn:outgoing>SFK0_3</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LKC0_3_def" name="R3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="LKC0_4" name="Переход из ряда 3">
      <bpmn:outgoing>SFK0_4</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LKC0_4_def" name="R4" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="LKT0_5" name="Переход к ряду 5">
      <bpmn:incoming>SFT0_5</bpmn:incoming>
      <bpmn:linkEventDefinition id="LKT0_5_def" name="R5" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="LKT0_6" name="Переход к ряду 5">
      <bpmn:incoming>SFT0_6</bpmn:incoming>
      <bpmn:linkEventDefinition id="LKT0_6_def" name="R6" />
